// Worker points: реестр точек, участник рации и прямой вход по адресу. Блоки — в хранилище флота по привязке STORE.
{
  "name": "switchboard-points",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // блоки по ссылке: хранилище бывает Worker'ом той же зоны — fetch идёт снаружи, как у Host (иначе 1042 → 404)
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // прямой вход: POST кадра с пропуском — обёртка entrance из контракта gate
  "services": [
    { "binding": "GATE", "service": "switchboard-gate", "entrypoint": "Gate" },
    // журнал: строки о сессиях точек
    { "binding": "LEDGER", "service": "switchboard-ledger", "entrypoint": "Participant" },
    // хранилище блоков: одна реализация контракта blocks под именем службы
    { "binding": "STORE", "service": "switchboard-blocks", "entrypoint": "Blocks" }
  ],
  // уборка раз в сутки: правило хранения и блоки без ссылок
  "triggers": { "crons": ["17 3 * * *"] },
  "preview_urls": false,
  "observability": { "enabled": true },
  // SDK (points.history) строит путь от import.meta.url — в Worker'е его нет: адрес модуля — постоянный
  "define": { "import.meta.url": "\"file:///switchboard-points/index.js\"" },
  // записи модуля — база D1 модуля во флоте
  "d1_databases": [{ "binding": "DB", "database_name": "switchboard-points", "database_id": "b1547083-f378-46a0-ade5-02a137f27ff4", "migrations_dir": "migrations" }],
  // объект реестра ушёл: записи перенесены в базу D1
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Registry"] }, { "tag": "v2", "deleted_classes": ["Registry"] }],
  // прод: своя база и свои службы
  "env": {
    "prod": {
      // свой домен прода: адрес Worker'а в сборках страниц и keeper.json машин прода
      "routes": [{ "pattern": "points.pfarm.app", "custom_domain": true }],
      "workers_dev": false,
      "services": [
        { "binding": "GATE", "service": "switchboard-gate-prod", "entrypoint": "Gate" },
        { "binding": "LEDGER", "service": "switchboard-ledger-prod", "entrypoint": "Participant" },
        { "binding": "STORE", "service": "switchboard-blocks-prod", "entrypoint": "Blocks" }
      ],
      "triggers": { "crons": ["17 3 * * *"] },
      "define": { "import.meta.url": "\"file:///switchboard-points/index.js\"" },
      "d1_databases": [{ "binding": "DB", "database_name": "switchboard-points-prod", "database_id": "344cbc13-9127-48c3-92a0-6078cffc8b30", "migrations_dir": "migrations" }]
    }
  }
}
