// Worker points: реестр точек, участник рации и прямой вход по адресу.
// Секрет R2_KEY_SECRET — секрет пары S3 токена R2 бакета точек (id пары — R2_KEY_ID в vars); wrangler secret put из stdin.
{
  "name": "switchboard-points",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // прямой вход: POST кадра с пропуском — обёртка entrance из контракта gate
  "services": [{ "binding": "GATE", "service": "switchboard-gate", "entrypoint": "Gate" }],
  "preview_urls": false,
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "switchboard-points" }],
  "durable_objects": { "bindings": [{ "name": "REGISTRY", "class_name": "Registry" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Registry"] }],
  "vars": {
    "CF_ACCOUNT_ID": "e2bbfeb848083376095e5ebbd42dba2e",
    "R2_KEY_ID": "52ff079797a7b57156228a0ad6e9b30e",
    "POINTS_BUCKET": "switchboard-points"
  },
  // прод: свой бакет точек; R2_KEY_ID — пара токена R2 прода (бакеты switchboard-points-prod и switchboard-releases)
  "env": {
    "prod": {
      "workers_dev": false,
      "services": [{ "binding": "GATE", "service": "switchboard-gate-prod", "entrypoint": "Gate" }],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "switchboard-points-prod" }],
      "durable_objects": { "bindings": [{ "name": "REGISTRY", "class_name": "Registry" }] },
      "vars": {
        "CF_ACCOUNT_ID": "e2bbfeb848083376095e5ebbd42dba2e",
        "R2_KEY_ID": "d9a6cd9efef5927581212086e2ff4ede",
        "POINTS_BUCKET": "switchboard-points-prod"
      }
    }
  }
}
