// Worker points: реестр точек, участник рации без адреса в интернете.
// Секрет R2_TOKEN (токен API с правом выдавать временные ключи R2) — wrangler secret put из stdin.
{
  "name": "switchboard-points",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "switchboard-points" }],
  "durable_objects": { "bindings": [{ "name": "REGISTRY", "class_name": "Registry" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Registry"] }],
  "vars": {
    "CF_ACCOUNT_ID": "e2bbfeb848083376095e5ebbd42dba2e",
    "R2_PARENT_KEY_ID": "52ff079797a7b57156228a0ad6e9b30e",
    "POINTS_BUCKET": "switchboard-points"
  },
  // прод: свой бакет точек; R2_PARENT_KEY_ID — токен R2 прода (бакеты switchboard-points-prod и switchboard-releases)
  "env": {
    "prod": {
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "switchboard-points-prod" }],
      "durable_objects": { "bindings": [{ "name": "REGISTRY", "class_name": "Registry" }] },
      "vars": {
        "CF_ACCOUNT_ID": "e2bbfeb848083376095e5ebbd42dba2e",
        "R2_PARENT_KEY_ID": "d9a6cd9efef5927581212086e2ff4ede",
        "POINTS_BUCKET": "switchboard-points-prod"
      }
    }
  }
}
