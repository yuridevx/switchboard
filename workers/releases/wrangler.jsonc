// Worker releases («выпуски»): каталог частей, stable, планы машин; участник рации и прямой вход по адресу.
// Секреты CLOUDFLARE_API_TOKEN (выкладка версий Worker'ов) и R2_LINK_KEY_ID / R2_LINK_SECRET
// (подпись ссылок на архивы) — wrangler secret put из stdin.
{
  "name": "switchboard-releases",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // прямой вход: POST кадра с пропуском — обёртка entrance из контракта gate
  "services": [
    { "binding": "GATE", "service": "switchboard-gate", "entrypoint": "Gate" },
    // план keeper'у — в объект relay его машины
    { "binding": "RELAY", "service": "switchboard", "entrypoint": "Relay" },
    // журнал: строки part.deployed
    { "binding": "LEDGER", "service": "switchboard-ledger", "entrypoint": "Participant" }
  ],
  "preview_urls": false,
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "switchboard-releases" }],
  // записи модуля — база D1 модуля во флоте
  "d1_databases": [{ "binding": "DB", "database_name": "switchboard-releases", "database_id": "a0cf449e-20dd-4837-bb15-576144855857", "migrations_dir": "migrations" }],
  // объект выпусков ушёл: строка флота перенесена в базу D1
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Releases"] }, { "tag": "v2", "deleted_classes": ["Releases"] }],
  "vars": {
    "CF_ACCOUNT_ID": "e2bbfeb848083376095e5ebbd42dba2e",
    // флот: имя Worker'а части — из module.json каталога (workers.<флот>)
    "FLEET": "test"
  },
  // прод: свои stable и планы машин; архивы частей машины — тот же бакет выпусков (CI грузит их один раз)
  "env": {
    "prod": {
      // свой домен прода: адрес Worker'а в сборках страниц и keeper.json машин прода
      "routes": [{ "pattern": "releases.pfarm.app", "custom_domain": true }],
      "workers_dev": false,
      "services": [
        { "binding": "GATE", "service": "switchboard-gate-prod", "entrypoint": "Gate" },
        { "binding": "RELAY", "service": "switchboard-prod", "entrypoint": "Relay" },
        { "binding": "LEDGER", "service": "switchboard-ledger-prod", "entrypoint": "Participant" }
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "switchboard-releases" }],
      "d1_databases": [{ "binding": "DB", "database_name": "switchboard-releases-prod", "database_id": "23066d12-7314-4a5c-aea2-d37299edbdf6", "migrations_dir": "migrations" }],
      "vars": {
        "CF_ACCOUNT_ID": "e2bbfeb848083376095e5ebbd42dba2e",
        "FLEET": "prod"
      }
    }
  }
}
