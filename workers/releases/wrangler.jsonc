// Worker releases («выпуски»): каталог частей, stable, планы машин; участник рации и прямой вход по адресу.
// Секреты CLOUDFLARE_API_TOKEN (выкладка версий Worker'ов) и R2_LINK_KEY_ID / R2_LINK_SECRET
// (подпись ссылок на архивы) — wrangler secret put из stdin.
{
  "name": "switchboard-releases",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // прямой вход: POST кадра с пропуском — обёртка entrance из контракта gate
  "services": [
    { "binding": "GATE", "service": "switchboard-gate", "entrypoint": "Gate" },
    // план keeper'у — в объект relay его машины
    { "binding": "RELAY", "service": "switchboard", "entrypoint": "Relay" }
  ],
  "preview_urls": false,
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "switchboard-releases" }],
  "durable_objects": { "bindings": [{ "name": "RELEASES", "class_name": "Releases" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Releases"] }],
  "vars": {
    "CF_ACCOUNT_ID": "e2bbfeb848083376095e5ebbd42dba2e",
    // части Cloudflare: имя части → имя Worker'а
    "CLOUD": {
      "relay": "switchboard",
      "gate": "switchboard-gate",
      "push": "switchboard-push",
      "points": "switchboard-points",
      "ledger": "switchboard-ledger",
      "github": "switchboard-github",
      "releases": "switchboard-releases",
      "phone": "switchboard-phone",
      "pult": "switchboard-pult"
    }
  },
  // прод: свои stable и планы машин; архивы частей машины — тот же бакет выпусков (CI грузит их один раз)
  "env": {
    "prod": {
      "workers_dev": false,
      "services": [
        { "binding": "GATE", "service": "switchboard-gate-prod", "entrypoint": "Gate" },
        { "binding": "RELAY", "service": "switchboard-prod", "entrypoint": "Relay" }
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "switchboard-releases" }],
      "durable_objects": { "bindings": [{ "name": "RELEASES", "class_name": "Releases" }] },
      "vars": {
        "CF_ACCOUNT_ID": "e2bbfeb848083376095e5ebbd42dba2e",
        "CLOUD": {
          "relay": "switchboard-prod",
          "gate": "switchboard-gate-prod",
          "push": "switchboard-push-prod",
          "points": "switchboard-points-prod",
          "ledger": "switchboard-ledger-prod",
          "github": "switchboard-github-prod",
          "releases": "switchboard-releases-prod",
          "phone": "switchboard-phone-prod",
          "pult": "switchboard-pult-prod"
        }
      }
    }
  }
}
