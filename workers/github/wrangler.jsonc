// Worker github: приложение GitHub флота, участник рации и прямой вход по адресу.
// Секретов Worker нет: ключ приложения github кладёт в свою базу D1 при настройке с пульта.
{
  "name": "switchboard-github",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // прямой вход: POST кадра с пропуском — обёртка entrance из контракта gate
  "services": [{ "binding": "GATE", "service": "switchboard-gate", "entrypoint": "Gate" }],
  "preview_urls": false,
  "observability": { "enabled": true },
  // записи модуля — база D1 модуля во флоте
  "d1_databases": [{ "binding": "DB", "database_name": "switchboard-github", "database_id": "986ee07a-283a-46d5-b3c7-e4df2c27194a", "migrations_dir": "migrations" }],
  // объект приложения ушёл: запись перенесена в базу D1
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["App"] }, { "tag": "v2", "deleted_classes": ["App"] }],
  "env": {
    "prod": {
      // свой домен прода: адрес Worker'а в сборках страниц и keeper.json машин прода
      "routes": [{ "pattern": "github.pfarm.app", "custom_domain": true }],
      "workers_dev": false,
      "services": [{ "binding": "GATE", "service": "switchboard-gate-prod", "entrypoint": "Gate" }],
      "d1_databases": [{ "binding": "DB", "database_name": "switchboard-github-prod", "database_id": "14d6abf8-d944-4634-af3a-e9569b6a74ab", "migrations_dir": "migrations" }]
    }
  }
}
