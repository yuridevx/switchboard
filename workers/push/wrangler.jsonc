// Worker push: участник рации и прямой вход по адресу. Секрет VAPID_PRIVATE — wrangler secret put из stdin.
{
  "name": "switchboard-push",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // прямой вход: POST кадра с пропуском — обёртка entrance из контракта gate
  "services": [
    { "binding": "GATE", "service": "switchboard-gate", "entrypoint": "Gate" },
    // чаты Telegram — устройства того же адреса
    { "binding": "ROOMS", "service": "switchboard-rooms", "entrypoint": "Rooms" }
  ],
  "preview_urls": false,
  "observability": { "enabled": true },
  // записи модуля — база D1 модуля во флоте
  "d1_databases": [{ "binding": "DB", "database_name": "switchboard-push", "database_id": "a0e33f07-d1ba-44cc-91a2-875f9234056e", "migrations_dir": "migrations" }],
  // объект подписок ушёл: записи перенесены в базу D1
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Subs"] }, { "tag": "v2", "deleted_classes": ["Subs"] }],
  "vars": { "VAPID_SUB": "https://switchboard.yuridevx1608.workers.dev" },
  "env": {
    "prod": {
      // свой домен прода: адрес Worker'а в сборках страниц и keeper.json машин прода
      "routes": [{ "pattern": "push.pfarm.app", "custom_domain": true }],
      "workers_dev": false,
      "services": [{ "binding": "GATE", "service": "switchboard-gate-prod", "entrypoint": "Gate" }, { "binding": "ROOMS", "service": "switchboard-rooms-prod", "entrypoint": "Rooms" }],
      "d1_databases": [{ "binding": "DB", "database_name": "switchboard-push-prod", "database_id": "63d993ee-6d9a-48e2-a492-7e6ba94279ec", "migrations_dir": "migrations" }],
      "vars": { "VAPID_SUB": "https://phone.pfarm.app" }
    }
  }
}
