// Worker prefs: настройки пользователя без состояния, записи — в своей базе D1, отдельно от служебных баз флота. Секретов нет.
{
  "name": "switchboard-prefs",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // прямой вход: POST кадра с пропуском — обёртка entrance из контракта gate
  "services": [
    { "binding": "GATE", "service": "switchboard-gate", "entrypoint": "Gate" },
    // кадр prefs.changed — в объект relay каждой машины
    { "binding": "RELAY", "service": "switchboard", "entrypoint": "Relay" }
  ],
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [{ "binding": "DB", "database_name": "switchboard-prefs", "database_id": "e85c4770-9fca-4394-9445-610ae5c466bf", "migrations_dir": "migrations" }],
  "env": {
    "prod": {
      // свой домен прода: адрес Worker'а в сборках страниц
      "routes": [{ "pattern": "prefs.pfarm.app", "custom_domain": true }],
      "workers_dev": false,
      "services": [
        { "binding": "GATE", "service": "switchboard-gate-prod", "entrypoint": "Gate" },
        { "binding": "RELAY", "service": "switchboard-prod", "entrypoint": "Relay" }
      ],
      "d1_databases": [{ "binding": "DB", "database_name": "switchboard-prefs-prod", "database_id": "caeac222-6e9b-40d5-9c81-d9c1aa895bfa", "migrations_dir": "migrations" }]
    }
  }
}
