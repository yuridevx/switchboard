// Worker blocks-r2: хранилище блоков точек на R2 — реализация контракта blocks под именем службы switchboard-blocks.
// Секрет R2_KEY_SECRET — секрет пары S3 токена R2 бакета точек (id пары — R2_KEY_ID в vars); wrangler secret put из stdin.
// Зовёт его только points привязкой; в сеть Worker не смотрит: ссылки ведут прямо в R2.
{
  "name": "switchboard-blocks",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "switchboard-points" }],
  "vars": {
    "CF_ACCOUNT_ID": "e2bbfeb848083376095e5ebbd42dba2e",
    "R2_KEY_ID": "52ff079797a7b57156228a0ad6e9b30e",
    "BLOCKS_BUCKET": "switchboard-points"
  },
  // прод: свой бакет точек; R2_KEY_ID — пара токена R2 прода
  "env": {
    "prod": {
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "switchboard-points-prod" }],
      "vars": {
        "CF_ACCOUNT_ID": "e2bbfeb848083376095e5ebbd42dba2e",
        "R2_KEY_ID": "d9a6cd9efef5927581212086e2ff4ede",
        "BLOCKS_BUCKET": "switchboard-points-prod"
      }
    }
  }
}
