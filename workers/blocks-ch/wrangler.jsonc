// Worker blocks-ch: хранилище блоков точек на ClickHouse — реализация контракта blocks под именем службы switchboard-blocks.
// ClickHouse — на машине hz-ex44-1 за туннелем Cloudflare switchboard-ch: адрес ch.pfarm.app впускает только Cloudflare Access с сервисным токеном.
// Секреты (~/.switchboard-dev/clickhouse.env, wrangler secret put из stdin): CH_PASSWORD — пароль пользователя ClickHouse этого флота,
// CH_ACCESS_ID и CH_ACCESS_SECRET — сервисный токен Access.
{
  "name": "switchboard-blocks",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // ссылки на блоки ведут в этот Worker
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "CH_URL": "https://ch.pfarm.app", "CH_USER": "sb_test", "BLOCKS_URL": "https://switchboard-blocks.yuridevx1608.workers.dev" },
  "env": {
    "prod": {
      "routes": [{ "pattern": "blocks.pfarm.app", "custom_domain": true }],
      "workers_dev": false,
      "vars": { "CH_URL": "https://ch.pfarm.app", "CH_USER": "sb_prod", "BLOCKS_URL": "https://blocks.pfarm.app" }
    }
  }
}
