// relay в тестах: тот же код; gate — настоящий за переключателем, журнал — поддельный Worker из vitest.config.ts.
{
  "name": "switchboard",
  "main": "../src/index.ts",
  "compatibility_date": "2026-08-01",
  "durable_objects": { "bindings": [{ "name": "FLEET", "class_name": "Fleet" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Fleet"] }],
  "services": [
    { "binding": "GATE", "service": "switchboard-gate", "entrypoint": "Gate" },
    { "binding": "LEDGER", "service": "switchboard-ledger", "entrypoint": "Participant" }
  ],
  "vars": {
    "PROTO": [1],
    // стенд: предел вызова журнала короче боевого 120 с
    "CALL_MS": 500
  }
}
