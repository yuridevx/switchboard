{
  "name": "relay",
  "type": "worker",
  "version": "1.3.0",
  "provides": {
    "hello": 1,
    "roster": 1,
    "session.state": 1,
    "keys.revoke": 1,
    "relay.deliver": 1,
    "relay.broadcast": 1
  },
  "tools": {
    "keys.revoke": {
      "about": "Отозвать пропуск или непринятое приглашение по номеру: строка у gate удалена, соединения с этим номером закрыты на всех машинах.",
