// relay: вход без состояния и объект на машину — wss /m/<машина>.
// Публичный адрес switchboard.<subdomain>.workers.dev; секретов нет, на диск не пишет.
// Привязки: gate — пропуск на hello и отзыв, журнал — вход и уход машины.
{
  "name": "switchboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  // версия кода: соединения прежнего кода закрываются при старте объекта
  "version_metadata": { "binding": "CF_VERSION" },
  "durable_objects": {
    "bindings": [{ "name": "FLEET", "class_name": "Fleet" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Fleet"] }],
  "services": [
    { "binding": "GATE", "service": "switchboard-gate", "entrypoint": "Gate" },
    { "binding": "LEDGER", "service": "switchboard-ledger", "entrypoint": "Participant" },
  ],
  "vars": {
    // версии контракта relay, которые он принимает в hello
    "PROTO": [1]
  },
  "observability": { "enabled": true },
  // прод: тот же код, свои Worker-модули с суффиксом -prod, адрес wss://relay.pfarm.app (wrangler --env prod)
  "env": {
    "prod": {
      "workers_dev": false,
      "routes": [{ "pattern": "relay.pfarm.app", "custom_domain": true }],
      // версия кода: соединения прежнего кода закрываются при старте объекта
      "version_metadata": { "binding": "CF_VERSION" },
      "durable_objects": {
        "bindings": [{ "name": "FLEET", "class_name": "Fleet" }]
      },
      "services": [
        { "binding": "GATE", "service": "switchboard-gate-prod", "entrypoint": "Gate" },
        { "binding": "LEDGER", "service": "switchboard-ledger-prod", "entrypoint": "Participant" },
      ],
      "vars": {
        "PROTO": [1]
      }
    }
  }
}
