// Worker ledger: журнал флота без состояния, записи — в базе D1;, участник рации и прямой вход по адресу. Секретов нет.
{
  "name": "switchboard-ledger",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // прямой вход: POST кадра с пропуском — обёртка entrance из контракта gate
  "services": [{ "binding": "GATE", "service": "switchboard-gate", "entrypoint": "Gate" }],
  "preview_urls": false,
  "observability": { "enabled": true },
  // записи модуля — база D1 модуля во флоте
  "d1_databases": [{ "binding": "DB", "database_name": "switchboard-ledger", "database_id": "3689c045-3574-4537-bd08-20b83a0d4938", "migrations_dir": "migrations" }],
  // объект журнала ушёл: записи перенесены в базу D1
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Journal"] }, { "tag": "v2", "deleted_classes": ["Journal"] }],
  "env": {
    "prod": {
      "workers_dev": false,
      "services": [{ "binding": "GATE", "service": "switchboard-gate-prod", "entrypoint": "Gate" }],
      "d1_databases": [{ "binding": "DB", "database_name": "switchboard-ledger-prod", "database_id": "b0c3d805-2d07-4f67-8034-51f474703337", "migrations_dir": "migrations" }]
    }
  }
}
