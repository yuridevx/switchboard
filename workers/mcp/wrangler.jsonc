// Worker mcp: один публичный сервер MCP флота (Streamable HTTP, /mcp) для сессий флота и внешних Claude. Состояния нет.
// Инструменты — releases.tools («Выпуски» собирают их из манифестов); вызов — прямой POST владельцу с пропуском клиента.
// GATE_URL — сервер входа OAuth в метаданных ресурса.
{
  "name": "switchboard-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // вызов владельцу — по его публичному адресу той же зоны: без флага Cloudflare отвечает 1042
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "services": [
    { "binding": "GATE", "service": "switchboard-gate", "entrypoint": "Gate" },
    { "binding": "RELEASES", "service": "switchboard-releases", "entrypoint": "Participant" }
  ],
  "vars": { "GATE_URL": "https://switchboard-gate.yuridevx1608.workers.dev" },
  "env": {
    "prod": {
      "routes": [{ "pattern": "mcp.pfarm.app", "custom_domain": true }],
      "workers_dev": false,
      "services": [
        { "binding": "GATE", "service": "switchboard-gate-prod", "entrypoint": "Gate" },
        { "binding": "RELEASES", "service": "switchboard-releases-prod", "entrypoint": "Participant" }
      ],
      "vars": { "GATE_URL": "https://gate.pfarm.app" }
    }
  }
}
