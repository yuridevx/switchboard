l","string"]}},"required":["decision","next_step","reason"],"type":"object"},"strict":true,"type":"function"}],"type":"namespace"}],"top_logprobs":0,"top_p":1.0,"truncation":"disabled","usage":{"input_tokens":3512,"input_tokens_details":{"cached_tokens":0},"output_tokens":1137,"output_tokens_details":{"reasoning_tokens":988},"total_tokens":4649}},"sequence_number":24,"type":"response.completed"}

