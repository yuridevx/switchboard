// Worker switchboard-pult: только статика выпуска пульта (Workers static assets).
// Сборка — npm run build (dist/); выпуск — npx wrangler deploy из этой папки.
{
  "name": "switchboard-pult",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist"
  },
  // прод — https://pult.pfarm.app; сборка с RELAY_URL=wss://relay.pfarm.app
  "env": {
    "prod": {
      "workers_dev": false,
      "routes": [{ "pattern": "pult.pfarm.app", "custom_domain": true }]
    }
  }
}
