// Worker switchboard-phone: только статика выпуска телефона (Workers static assets).
// Сборка — npm run build (dist/); выпуск — npx wrangler deploy из этой папки.
{
  "name": "switchboard-phone",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // прод — https://phone.pfarm.app; сборка с RELAY_URL=wss://relay.pfarm.app
  "env": {
    "prod": {
      "workers_dev": false,
      "routes": [{ "pattern": "phone.pfarm.app", "custom_domain": true }]
    }
  }
}
