{
  "name": "switchboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "protocol",
    "tools/*",
    "workers/*",
    "host/core",
    "host/modules/*",
    "web/packages/*",
    "web/phone",
    "web/pult"
  ],
  "scripts": {
    "gate": "node tools/manifest-gate/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run gate && vitest run",
    "test:workers": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261031.1",
    "@types/node": "24.19.2",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.311"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261023.1": true
  }
}
